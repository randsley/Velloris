# Velloris Environment Configuration
# Copy this file to .env and customize for your setup

# Whisper STT Model
# Options: tiny (fastest), base (default), small, medium, large (most accurate)
WHISPER_MODEL=base

# Ollama LLM Model
# Requires Ollama to be running: ollama serve
# Common options: llama3, neural-chat, mistral, openchat
OLLAMA_MODEL=llama3

# Ollama Host
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Default Device
# Options: cuda (GPU), cpu (CPU), mps (Apple Metal)
# Auto-detects CUDA if available
DEFAULT_DEVICE=cuda

# Voice Reference Audio (for voice cloning)
# Path to 3-5 second reference audio file
# Used for voice cloning in dubbing mode
VOICE_REFERENCE=voices/reference.wav

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Application Mode
# Options: interactive, dubbing
# Default: interactive
# VELLORIS_MODE=interactive

# Optional: Transcript Output
# Save transcriptions to file
# TRANSCRIPT_FILE=transcripts.txt

# Optional: Audio Recording
# Save audio input/output for debugging
# RECORD_AUDIO=false
# AUDIO_DIR=recordings/
