# Velloris v2.0 Environment Configuration
# Copy this file to .env and customize for your setup

# ============================
# Operating Mode Configuration
# ============================

# Default Operating Mode
# Options: realtime, dubbing, creative
# - realtime: PersonaPlex end-to-end S2S (ultra-low latency, full-duplex)
# - dubbing: Qwen3-TTS high-fidelity narration (multilingual, professional)
# - creative: Ollama + Qwen3-TTS (emotional synthesis, storytelling)
DEFAULT_MODE=realtime

# ============================
# Real-Time Mode Settings
# ============================
# Used when mode=realtime (PersonaPlex-7B end-to-end S2S)
# No Ollama required for this mode

# Voice Selection (16 preset voices available)
# Natural Female: NATF0, NATF1, NATF2, NATF3
# Natural Male: NATM0, NATM1, NATM2, NATM3
# Varied Female: VARF0, VARF1, VARF2, VARF3, VARF4
# Varied Male: VARM0, VARM1, VARM2, VARM3, VARM4
REALTIME_VOICE=NATF2

# Persona/Role for the AI assistant
# Controls the agent's personality and behavior
REALTIME_PERSONA=You are a helpful and friendly AI assistant.

# ============================
# Creative Mode Settings
# ============================
# Used when mode=creative (Ollama + Qwen3-TTS)
# REQUIRES Ollama to be running: ollama serve

# Ollama Model Selection
# Common options: llama3, llama3.1, mistral, mixtral, neural-chat, openchat
# Install with: ollama pull <model_name>
CREATIVE_LLM=llama3

# Ollama Host URL
# Default: http://localhost:11434
# Change if Ollama is running on a different host/port
OLLAMA_HOST=http://localhost:11434

# Default Emotion/Style Instruction (optional)
# Example: "Speak with excitement", "Use a calm and soothing tone"
# Leave empty for neutral tone
CREATIVE_EMOTION=

# ============================
# Dubbing Mode Settings
# ============================
# Used when mode=dubbing (Qwen3-TTS high-fidelity synthesis)
# No Ollama required for this mode

# Voice Reference Audio (optional, for voice cloning)
# Path to 3-5 second reference audio file
# Leave empty to use default voice
VOICE_REFERENCE=voices/reference.wav

# ============================
# Legacy/Deprecated Settings
# ============================
# The following settings are deprecated but maintained for backward compatibility

# DEPRECATED: Use CREATIVE_LLM instead
OLLAMA_MODEL=llama3

# DEPRECATED: Whisper STT not actively used in v2.0
# Options: tiny (fastest), base (default), small, medium, large (most accurate)
WHISPER_MODEL=base

# ============================
# Device Configuration
# ============================

# Default Computing Device
# Options: auto, cuda, mps, cpu
# - auto: Automatically detect best device (CUDA → MPS → CPU)
# - cuda: NVIDIA GPU (Windows/Linux, optimal performance)
# - mps: Apple Metal (macOS M1/M2/M3/M4, good performance)
# - cpu: CPU only (slowest, use as fallback)
DEFAULT_DEVICE=auto

# ============================
# Logging & Debugging
# ============================

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Save transcriptions to file
# Uncomment to enable transcript logging
# TRANSCRIPT_FILE=transcripts.txt

# Optional: Audio Recording for debugging
# Save audio input/output to disk
# RECORD_AUDIO=false
# AUDIO_DIR=recordings/

# ============================
# Advanced Configuration
# ============================
# These settings rarely need to be changed

# Audio Sample Rates (auto-configured, don't change unless needed)
# INPUT_SAMPLE_RATE=16000   # VAD and Whisper standard
# OUTPUT_SAMPLE_RATE=24000  # PersonaPlex/Qwen3 output

# Buffer Settings
# BUFFER_DURATION=2.0  # Transcribe every N seconds
# CHUNK_SIZE=512       # Audio frames per callback

# VAD Configuration
# VAD_THRESHOLD=0.5              # Voice Activity Detection threshold (0.0-1.0)
# VAD_MIN_SPEECH_DURATION=0.3    # Minimum speech duration in seconds
# VAD_MIN_SILENCE_DURATION=0.3   # Minimum silence duration in seconds
# ENABLE_BARGE_IN=true           # Allow user interruptions

# Timeout Settings (seconds)
# REALTIME_TIMEOUT=30.0   # Real-time mode user input timeout
# CREATIVE_TIMEOUT=120.0  # Creative mode LLM response timeout
# DUBBING_TIMEOUT=60.0    # Dubbing mode TTS generation timeout

# Performance Tuning
# MAX_WORKERS=4           # Thread pool size for concurrent tasks
# ENABLE_PROFILING=false  # Enable performance profiling (debug only)

# ============================
# Migration Notes (v1.x → v2.0)
# ============================
#
# Major Changes:
# 1. DEFAULT_MODE renamed: "interactive" → "realtime" or "creative"
# 2. Ollama now OPTIONAL (only needed for creative mode)
# 3. New settings: REALTIME_VOICE, REALTIME_PERSONA, CREATIVE_EMOTION
#
# Migration Guide:
# - Old "interactive" users → Use "realtime" for faster conversations (no Ollama)
# - Old "interactive" users → Use "creative" for LLM reasoning (requires Ollama)
# - Old "dubbing" users → No changes needed!
#
# See MIGRATION.md for detailed migration instructions.
